# X Developer App. The access token must be OAuth 2.0 user context for the
# BuddyBox X account, with dm.read, dm.write, users.read, tweet.read, and
# offline.access when refresh is enabled.
X_OAUTH_ACCESS_TOKEN=
X_OAUTH_REFRESH_TOKEN=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# App-only bearer used by GET /2/activity/stream. This is required to discover
# Message-request conversations that do not appear in the primary inbox.
X_APP_BEARER_TOKEN=

# The X Chat identity belongs to the BuddyBox bot account. At startup the bridge
# fetches this account's current public-key records with user-context OAuth,
# extracts fresh Juicebox realm tokens from the newest juicebox_config, recovers
# the identity with this PIN, and adopts the registered version its key matches.
# Never log or expose the PIN, OAuth response, or Juicebox material.
X_CHAT_USER_ID=
X_CHAT_PIN=

# First-class Convex X Chat broker and shared route encryption.
CONVEX_XCHAT_BROKER_URL=https://your-deployment.convex.site/v1/xchat/broker
PUBLIC_PORTAL_URL=https://buddybox.buddytools.org
BUDDYBOX_BRIDGE_SECRET=
BUDDYBOX_ROUTE_ENCRYPTION_KEY=
BUDDYBOX_ADDRESS_PEPPER=

# Mount an encrypted persistent Railway volume at /data.
XCHAT_VAULT_PATH=/data/xchat-vault.json
XCHAT_VAULT_ENCRYPTION_KEY=
# Fast Convex outbound lease/reply recovery poll.
XCHAT_POLL_INTERVAL_MS=2000
# Primary-inbox safety sweep; Activity stream events trigger immediate reads.
XCHAT_INBOX_POLL_INTERVAL_MS=60000
PORT=3000
