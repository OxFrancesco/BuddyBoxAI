{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buddybox-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "buddybox.buddytools.org/v1/orchestration/*",
      "zone_name": "buddytools.org"
    }
  ],
  "services": [
    { "binding": "AGENT_GATEWAY", "service": "buddybox-agent-gateway" }
  ],
  "observability": { "enabled": true }
}
