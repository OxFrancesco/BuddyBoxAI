# Photon Spectrum Cloud project credentials. Never commit live values.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# webhook (recommended), grpc, or hybrid. Hybrid is useful only during a
# migration because Convex deduplicates the same Spectrum message ID.
SPECTRUM_INGRESS_MODE=webhook
SPECTRUM_WEBHOOK_SECRET=
# Optional: fail closed unless deliveries name this exact registered webhook.
SPECTRUM_WEBHOOK_ID=

# Trusted Convex HTTP broker and its shared bridge credential.
CONVEX_BRIDGE_URL=https://your-deployment.convex.site/bridge/spectrum
ICHEF_BRIDGE_SECRET=

# Separate HMAC key used to pseudonymize iMessage addresses before admission.
ICHEF_ADDRESS_PEPPER=

PORT=3000
