# Public browser configuration. These values are safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=https://replace-me.convex.cloud

# Server-only Clerk credential. Never prefix this value with VITE_.
CLERK_SECRET_KEY=

# Set this on the Convex deployment, not in browser code:
# bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Written by `bunx convex dev`; keep it local and secret.
CONVEX_DEPLOYMENT=dev:replace-me
